# 复制为 .env 并填真实值（.env 不入库）。兼容两套命名：LLM_* 优先，回退标准 OPENAI_*
OPENAI_BASE_URL=http://127.0.0.1:3425/v1
OPENAI_API_KEY=sk-xxxx
LLM_MODEL=zhipu/glm-5.3-flash
LLM_TEMPERATURE=0.85
# 可选：ADMIN_ADDR=:18061  ADMIN_TOKEN=xxx  XHS_PROXY=http://...  COOKIES_PATH=./cookies.json

# 看评论行为(可选, 括号为默认)
# XHS_CR_OPEN_PROB=0.7
# XHS_CR_OPEN_SCREENS_MIN=2
# XHS_CR_OPEN_SCREENS_MAX=5
# XHS_CR_COMMENT_PROB=0.6
# XHS_CR_COMMENT_SCREENS_MIN=1
# XHS_CR_COMMENT_SCREENS_MAX=3
# XHS_CR_DWELL_MIN=1
# XHS_CR_DWELL_MAX=4
